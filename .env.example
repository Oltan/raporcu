# divan yapılandırması. Bu dosyayı .env olarak kopyalayın. Ortam değişkenleri .env'i ezer.
# Yorum satırı olan ayarlar bir bağlantıyı (GitLab, Jira, e-posta) açar; kullanacaksanız doldurup açın.
# Bu dosya yalnızca sunucu içindir: ulak ve kod ajanı (OpenCode / Claude Code) ayarları runner
# ortamına yazılır, dolu örnek: ci/gitlab/runner/runner.env.example (pakette sunucu/runner.env.example).

# --- Temel ---
DATA_DIR=/var/lib/divan
BIND_ADDR=0.0.0.0:8080
# Raporlardaki ve e-postalardaki linkler için dış adres
PUBLIC_URL=http://divan.sirket.local:8080
LOG_LEVEL=info
LOG_STDOUT=true
LOG_MAX_DAYS=14
LOG_MAX_MB=500

# --- Güvenlik (SW-9.x) ---
# CI işlerinin kullandığı token (GitLab'da masked CI değişkeni olarak da tanımlanır)
CI_API_TOKEN=degistirin-uzun-rastgele-bir-deger
# `divan set-admin-password` ile yazılır, elle düzenlemeyin
# ADMIN_PASSWORD_HASH='$argon2id$...'
# GitLab webhook ayarındaki "Secret token"
GITLAB_WEBHOOK_TOKEN=degistirin

# --- Şirket CA'sı (GitLab/Jira HTTPS) ---
# Varsayılan: işletim sisteminin sertifika deposu (Windows sertifika deposu / Linux /etc/ssl/certs).
# "invalid peer certificate: UnknownIssuer" alırsanız şirket kök sertifikasını sistem deposuna ekleyin
# ya da sertifika dosyasını / klasörünü verin (.pem/.crt/.cer/.cert; PEM ya da DER; klasörse içindeki
# bütün sertifikalar). Makinede sistem ortam değişkeni olarak tanımlarsanız ulak (MR, git push,
# OpenCode) da aynısını kullanır. Yalnızca bu sertifikalara güvenilir. Windows yolu bu dosyada tek
# tırnak içinde yazılır; tırnaksız \ hata verir ve bu satırdan sonraki ayarlar sessizce yüklenmez:
# DIVAN_CA_DOSYASI='C:\divan\sirket-ca.cert'

# --- GitLab API (SW-7.4: "OpenCode ile düzelt" düğmesi) ---
# GITLAB_URL=https://gitlab.sirket.local
# GITLAB_TOKEN=glpat-...   (api kapsamı; yalnızca burada durur, loglara yazılmaz)

# --- Bellek ve boyut sınırları (SW-10.6) ---
MAX_UPLOAD_MB=512
MAX_ENTRY_MB=256
MAX_ZIP_ENTRIES=50000
MEMORY_TARGET_MB=100
SQLITE_CACHE_KIB=8192
DB_READ_POOL=4

# --- Koşum ---
RUN_STALL_TIMEOUT_SECS=900
FLAKY_WINDOW=10
TRIAGE_AUTO_CONFIDENCE=0.7

# --- Yedek (SW-2.5) ---
BACKUP_HOUR=3
BACKUP_KEEP=7

# --- Disk (SW-10.8) ---
DISK_WARN_PCT=80
DISK_CLEAN_PCT=90

# --- DOORS (SW-6.4) ---
# Aktarım CSV ile (koşum sayfası > DOORS CSV). DXL betiği varsayılan kapalı.
DOORS_DXL=false

# --- Jira (SW-6.x) ---
# JIRA_URL=https://jira.sirket.local
# JIRA_TOKEN=...            (PAT; JIRA_USER verilirse Basic kimlik doğrulama)
# JIRA_USER=
# JIRA_PROJECT=STAJ
# JIRA_ISSUE_TYPE=Bug
# off | observe (varsayılan, bug açmaz, taslak hazırlar) | on
# Yalnızca bug açmayı yönetir. Jira bağlıyken kalan senaryo açık bir issue ile eşleşirse ona bağlanır ve
# ekran görüntüsü o issue'ya eklenir; bunu kapatmak için JIRA_URL'i boş bırakın (docs/JIRA_DOORS_AYARLARI.md §5).
JIRA_AUTO_CREATE=observe
JIRA_MAX_BUGS_PER_RUN=3
JIRA_REQUIRE_RETRY=true

# --- E-posta (SW-5.3) ---
# SMTP_HOST=smtp.sirket.local
# SMTP_PORT=25
MAIL_FROM=divan@sirket.local
# MAIL_TO=ekip@sirket.local,lider@sirket.local
DRY_RUN=false

# --- ulak dağıtımı (SW-10.9): ulak-linux ve ulak-windows.exe bu klasörde ---
# ULAK_DIR=/opt/divan/tools
