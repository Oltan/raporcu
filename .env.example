# stajproje yapılandırması. Bu dosyayı .env olarak kopyalayın. Ortam değişkenleri .env'i ezer.

# --- Temel ---
DATA_DIR=/var/lib/stajproje
BIND_ADDR=0.0.0.0:8080
# Raporlardaki ve e-postalardaki linkler için dış adres
PUBLIC_URL=http://stajproje.sirket.local:8080
LOG_LEVEL=info
LOG_STDOUT=true
LOG_MAX_DAYS=14
LOG_MAX_MB=500

# --- Güvenlik (SW-9.x) ---
# CI işlerinin kullandığı token (GitLab'da masked CI değişkeni olarak da tanımlanır)
CI_API_TOKEN=degistirin-uzun-rastgele-bir-deger
# `stajproje set-admin-password` ile yazılır, elle düzenlemeyin
# ADMIN_PASSWORD_HASH='$argon2id$...'
# GitLab webhook ayarındaki "Secret token"
GITLAB_WEBHOOK_TOKEN=degistirin

# --- GitLab API (SW-7.4: "OpenCode ile düzelt" düğmesi) ---
# GITLAB_URL=https://gitlab.sirket.local
# GITLAB_TOKEN=glpat-...   (api kapsamı; yalnızca burada durur, loglara yazılmaz)

# --- Bellek ve boyut sınırları (SW-10.6) ---
MAX_UPLOAD_MB=512
MAX_ENTRY_MB=256
MEMORY_TARGET_MB=100
SQLITE_CACHE_KIB=8192
DB_READ_POOL=4

# --- Koşum ---
RUN_STALL_TIMEOUT_SECS=900
FLAKY_WINDOW=10
TRIAGE_AUTO_CONFIDENCE=0.7

# --- Yedek (SW-2.5) ---
BACKUP_HOUR=3
BACKUP_KEEP=7

# --- Disk (SW-10.8) ---
DISK_WARN_PCT=80
DISK_CLEAN_PCT=90

# --- Jira (SW-6.x) ---
# JIRA_URL=https://jira.sirket.local
# JIRA_TOKEN=...            (PAT; JIRA_USER verilirse Basic kimlik doğrulama)
# JIRA_USER=
# JIRA_PROJECT=STAJ
# JIRA_ISSUE_TYPE=Bug
# off | observe (varsayılan, Jira'ya yazmaz) | on
JIRA_AUTO_CREATE=observe
JIRA_MAX_BUGS_PER_RUN=3
JIRA_REQUIRE_RETRY=true

# --- E-posta (SW-5.3) ---
# SMTP_HOST=smtp.sirket.local
# SMTP_PORT=25
MAIL_FROM=stajproje@sirket.local
# MAIL_TO=ekip@sirket.local,lider@sirket.local
DRY_RUN=false

# --- stajci dağıtımı (SW-10.9): stajci-linux ve stajci-windows.exe bu klasörde ---
# STAJCI_DIR=/opt/stajproje/tools
