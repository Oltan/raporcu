<?xml version="1.0" encoding="UTF-8"?>
<!-- divan test destek jar'ı (test projesinin içine girer):
       DivanKanit          hata anında ekran görüntüsü ve TestFX sahne ağacı
       CanliOlayEklentisi  canlı ekran için Cucumber olayları (JSON satırları)
       VideoKaydi          kalan senaryonun videosu
     Tek kaynak burası. Sürüm her değişiklikte artırılır; jar'ın MANIFEST'inde sürüm ve commit yazar.
     Derleme: mvn -B -f eklentiler/java/pom.xml package -Ddivan.commit=(kısa commit kimliği)
     Çıktı:   eklentiler/java/target/divan-test-destek-<sürüm>.jar -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.divan</groupId>
    <artifactId>divan-test-destek</artifactId>
    <version>1.1.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.10</javafx.version>
        <cucumber.version>7.34.9</cucumber.version>
        <testfx.version>4.0.18</testfx.version>
        <divan.commit>bilinmiyor</divan.commit>
    </properties>

    <!-- Tümü test projesinde zaten var; jar'a girmez. -->
    <dependencies>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>testfx-core</artifactId>
            <version>${testfx.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Implementation-Title>divan-test-destek</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                            <Divan-Commit>${divan.commit}</Divan-Commit>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
