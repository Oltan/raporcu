<!-- Test projesinin pom.xml dosyasına eklenir. Sürümler varsa projedekini koruyun. -->

<!-- <properties> içine -->
<allure.version>2.35.5</allure.version>
<test.xmx>768m</test.xmx>
<rerun.count>1</rerun.count>

<!-- <dependencyManagement><dependencies> içine -->
<dependency>
    <groupId>io.qameta.allure</groupId>
    <artifactId>allure-bom</artifactId>
    <version>${allure.version}</version>
    <type>pom</type>
    <scope>import</scope>
</dependency>

<!-- <dependencies> içine -->
<dependency>
    <groupId>com.divan</groupId>
    <artifactId>divan-test-destek</artifactId>
    <version>1.0.0</version>
    <scope>test</scope>
</dependency>
<dependency>
    <groupId>io.qameta.allure</groupId>
    <artifactId>allure-cucumber7-jvm</artifactId>
    <scope>test</scope>
</dependency>
<dependency>
    <groupId>org.openjfx</groupId>
    <artifactId>javafx-swing</artifactId>
    <version>${javafx.version}</version>
    <scope>test</scope>
</dependency>

<!-- <build><plugins> içine; varsa yalnızca eksik ayarları ekleyin -->
<plugin>
    <groupId>org.apache.maven.plugins</groupId>
    <artifactId>maven-compiler-plugin</artifactId>
    <version>3.15.0</version>
</plugin>
<plugin>
    <groupId>org.apache.maven.plugins</groupId>
    <artifactId>maven-surefire-plugin</artifactId>
    <version>3.5.4</version>
    <configuration>
        <forkCount>1</forkCount>
        <reuseForks>true</reuseForks>
        <argLine>-Xmx${test.xmx} -Djava.awt.headless=false -Dfile.encoding=UTF-8</argLine>
        <rerunFailingTestsCount>${rerun.count}</rerunFailingTestsCount>
        <systemPropertyVariables>
            <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
        </systemPropertyVariables>
    </configuration>
</plugin>
