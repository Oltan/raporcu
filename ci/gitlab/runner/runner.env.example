# Runner tarafı (ulak + OpenCode + Claude Code): tüm ortam değişkenleri, dolu örnek.
#
# Bu dosyayı hiçbir şey kendiliğinden OKUMAZ. divan'ın `.env` dosyası yalnızca sunucu içindir; ulak ve
# kod ajanı runner'da çalışır ve yalnızca süreç ortamını görür. Buradaki satırlar şuralardan birine
# yazılır:
#   - GitLab: test projesi (ya da grup) > Settings > CI/CD > Variables   ([MASKED] yazanlar burada, masked)
#   - runner `config.toml`: [[runners]] altında  environment = ["AD=deger", ...]   (config.toml.example)
#   - makinenin sistem ortam değişkenleri (sonra runner yeniden başlatılır)
# Linux'ta CI olmadan denemek için kopyasını kabuğa yükleyebilirsiniz:  set -a; . ./runner.env; set +a
#
# Boşluk ya da `\` içeren değerler tek tırnak içindedir; GitLab'a ya da config.toml'a yazarken tırnakları
# atın. Boş değer tanımsız sayılır. Açık satırlardaki değerler (adres, token ve model adı dışında)
# varsayılandır: yazmasanız da aynı sonuç. Yorum satırı olanlar davranışı değiştirir; gerekince açın.
# Şablonun `variables:` bölümünde zaten duranları (ULAK_SERVER, ULAK_RESULTS_DIR, ULAK_MAVEN_XMX,
# ULAK_TEST_XMX, ULAK_VIDEO_FPS, ULAK_XVFB, ULAK_SCREEN) değiştirmek için proje CI değişkeni kullanın.

# --- Sunucu bağlantısı ---
ULAK_SERVER=http://127.0.0.1:8080
# [MASKED] divan `.env` içindeki CI_API_TOKEN ile aynı
CI_API_TOKEN=degistirin-uzun-rastgele-bir-deger
# linux | windows: işler bu etiketli runner'a gider
ULAK_OS=linux
# sunucuya istek başarısız olursa yeniden deneme sayısı ve ilk bekleme (ms)
ULAK_RETRY_MAX=5
ULAK_RETRY_BASE_MS=2000

# --- Test koşumu ---
ULAK_TEST_COMMAND='mvn -B test'
ULAK_RESULTS_DIR=target/allure-results
ULAK_MAVEN_XMX=512m
ULAK_TEST_XMX=768m
# feature dosyalarının kökü (istemde ajana verilen yol)
ULAK_TEST_RESOURCES=src/test/resources/
# boşsa features.txt kullanılır
# ULAK_TAGS=@smoke
# test komutunun sonuna eklenen argümanlar
# ULAK_EXTRA_ARGS='-Dornek.ayar=1'
# test komutu Maven değilken de -Dtest.xmx, -Dallure.results.directory vb. eklensin
# ULAK_FORCE_MAVEN_ARGS=1
# önceki koşumun target/allure-results içeriği silinmesin
# ULAK_KEEP_RESULTS=1

# --- Ekran ve video ---
# Linux: on | off | auto (DISPLAY yoksa Xvfb). Windows işlerinde şablon off yapar
ULAK_XVFB=on
ULAK_SCREEN=1920x1080
ULAK_XVFB_RUN=xvfb-run
# kalan senaryonun videosu (ffmpeg varsa). Windows'ta tüm masaüstünü kaydeder; kişisel masaüstünde false
ULAK_VIDEO=true
ULAK_VIDEO_FPS=5
ULAK_VIDEO_CRF=35
# Windows: runner hizmet oturumundayken de koşsun (TestFX fare/klavye gönderemez; yalnızca deneme için)
# ULAK_ALLOW_SERVICE_SESSION=true

# --- Canlı aktarım (ulak watch) ---
# off: sonuçlar yalnızca report işinde toplu gider
ULAK_WATCH=on
ULAK_WATCH_INTERVAL_MS=1000
ULAK_WATCH_MAX_SECS=21600
ULAK_WATCH_DRAIN_SECS=30

# --- Yapay zekâ: LLM değerlendirmesi (ulak degerlendir) ve self-healing (ulak fix) ---
# off: ikisini de kapatır
ULAK_FIX=on
# off: yalnızca değerlendirmeyi kapatır; ULAK_FIX=off iken on: yalnızca değerlendirme çalışır
ULAK_DEGERLENDIR=on
# opencode | claude
ULAK_FIX_AGENT=opencode
# [MASKED] proje erişim tokenı (api + write_repository): auto-fix branch push + MR
ULAK_FIX_TOKEN=glpat-degistirin
# koşum başına en fazla senaryo
ULAK_FIX_MAX=3
ULAK_DEGERLENDIR_MAX=20
# ajan zaman aşımı (sn). ULAK_OPENCODE_TIMEOUT düzeltmede Claude Code için de geçerlidir
ULAK_OPENCODE_TIMEOUT=900
ULAK_DEGERLENDIR_TIMEOUT=300
# ajanın değiştirebileceği yollar (virgülle); dışına dokunan düzeltme geri alınır
ULAK_FIX_ALLOWED=src/test/
# on: auto-fix/... branch'ine push'ta da tüm e2e koşar (fix işi yine koşmaz)
# ULAK_FIX_PIPELINE=on
# doğrulama koşusunun komutu, olduğu gibi çalışır: senaryo süzgeci eklenmez
# (varsayılan: test komutu + yalnızca düzeltilen senaryo)
# ULAK_FIX_VALIDATE_CMD='mvn -B test -Dcucumber.filter.tags=@smoke'
# MR için GitLab API adresi (varsayılan: runner'ın verdiği CI_API_V4_URL)
# ULAK_GITLAB_API=https://gitlab.sirket.local/api/v4
# gerçek push yerine başka bir hedef (CI olmadan denemede yerel bare repo)
# ULAK_PUSH_REMOTE=/tmp/deneme.git

# --- OpenCode (ULAK_FIX_AGENT=opencode) ---
# model sunucusu, OpenAI uyumlu; sonu /v1
VLLM_BASE_URL=http://llm.sirket.local:8000/v1
# [MASKED] sunucu anahtar istemiyorsa herhangi bir değer
VLLM_API_KEY=degistirin
# sunucudaki tam model adı (vLLM --served-model-name)
VLLM_MODEL=qwen3-coder
# .opencode/agents/<ad>.md
ULAK_OPENCODE_AGENT=fix
ULAK_DEGERLENDIR_AGENT=degerlendir
ULAK_OPENCODE_BIN=opencode
# Windows: npm yalnızca kısayol koyar, gerçek yol verilir: Join-Path (npm root -g) "opencode-ai\bin\opencode.exe"
# ULAK_OPENCODE_BIN='C:\Users\testrunner\AppData\Roaming\npm\node_modules\opencode-ai\bin\opencode.exe'
# opencode.json'daki ve ajandaki modeli ezer (saglayici/model)
# ULAK_OPENCODE_MODEL=vllm/baska-model
# TestFX MCP sunucusu varsa jar yolu (opencode.json ve .mcp.json bunu okur)
# TESTFX_MCP_JAR=/opt/araclar/testfx-mcp.jar

# --- Claude Code (ULAK_FIX_AGENT=claude) ---
# ağ geçidi (ör. LiteLLM /v1/messages) ya da Anthropic biçimini konuşan sunucu
ANTHROPIC_BASE_URL=http://llm-gecidi.sirket.local:4000
# [MASKED] ağ geçidi anahtarı
ANTHROPIC_AUTH_TOKEN=degistirin
ANTHROPIC_MODEL=gorsel-model
# yardımcı istekler için küçük model; kapalı ağda o da aynı sunucuya yönlenmeli
ANTHROPIC_DEFAULT_HAIKU_MODEL=gorsel-model
# dışarıya telemetri/güncelleme isteğini kapatır (şablondaki .claude/settings.json da ayarlar)
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# ağ geçidi yerine doğrudan Anthropic API: yukarıdaki ANTHROPIC_BASE_URL ve ANTHROPIC_AUTH_TOKEN yazılmaz
# [MASKED]
# ANTHROPIC_API_KEY=sk-ant-degistirin

# --- Ajan komutunu tamamen değiştirmek ---
# Yer tutucular: {istem} istem metni, {ekran} ekran görüntüsü yolu (yoksa önceki bayrakla birlikte atılır),
# {istem_dosyasi}. Verilirse o adımda ULAK_OPENCODE_BIN / _AGENT / _MODEL kullanılmaz. Düzeltme ve
# değerlendirme ayrı komutlardır; ikisi de ezilecekse ikisi de yazılır. ulak ajana istem dosyasının yolunu
# ULAK_FIX_PROMPT_FILE ortam değişkeniyle de verir. ULAK_FIX_CMD'nin eski adı ULAK_OPENCODE_CMD'dir.
# Görsel desteklemeyen model (OpenCode): --file {ekran} kaldırılır
# ULAK_FIX_CMD='opencode run --agent fix {istem}'
# ULAK_DEGERLENDIR_CMD='opencode run --agent degerlendir {istem}'
# Claude Code tam yolla (varsayılan komutlar, yalnızca program yolu farklı)
# ULAK_FIX_CMD='C:\araclar\claude.exe -p {istem} --permission-mode acceptEdits --allowedTools Read,Edit,Write,Glob,Grep,Skill --disallowedTools Bash,WebFetch,WebSearch --max-turns 40 --output-format text'
# ULAK_DEGERLENDIR_CMD='C:\araclar\claude.exe -p {istem} --allowedTools Read,Glob,Grep,Skill --disallowedTools Edit,Write,Bash,WebFetch,WebSearch --max-turns 15 --output-format text'

# --- Şirket CA'sı (GitLab ya da model sunucusu şirket sertifikalı HTTPS ise) ---
# Sertifika dosyası ya da klasörü. ulak sırayla ULAK_CA_DOSYASI, DIVAN_CA_DOSYASI, CI_SERVER_TLS_CA_FILE
# değişkenlerine bakar, hiçbiri yoksa sistem deposunu kullanır; MR, git push ve ajan aynısını görür.
# ULAK_CA_DOSYASI='C:\divan\sirket-ca.cert'
# DIVAN_CA_DOSYASI='C:\divan\sirket-ca.cert'
# ajana verilecek PEM'i kendiniz seçmek için (tanımlıysa ulak dokunmaz)
# NODE_EXTRA_CA_CERTS=/etc/ssl/sirket-ca.pem

# --- Yollar (varsayılan: işin çalışma klasörü) ---
# ULAK_PROJECT_DIR=/isler/test-projesi
# ULAK_STATE_DIR=/isler/test-projesi/.ulak
# ULAK_CANLI_DOSYA=target/ulak-canli/olaylar.jsonl

# --- CI dışında (elle) çalıştırırken: GitLab'ın verdiği bilgilerin yerine ---
# ULAK_PROJECT=ekip/test-projesi
# ULAK_BRANCH=main

# --- Elle ayarlanmaz: ulak ya da divan kendisi verir ---
# test işi ulak.env (dotenv) ile sonraki işlere aktarır; CI olmadan `ulak fix` denerken elle verilir
# ULAK_RUN_ID=42
# ULAK_REPORT_URL=http://divan.sirket.local:8080/runs/42
# divan'daki "düzelt" düğmesi pipeline'ı bunlarla başlatır
# ULAK_FIX_ONLY=true
# ULAK_FIX_SCENARIO_ID=1234
