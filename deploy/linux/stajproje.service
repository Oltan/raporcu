# /etc/systemd/system/stajproje.service
# Kurulum: docs/GITLAB_CI_KURULUMU.md, "stajproje sunucusu (Ubuntu)"
[Unit]
Description=stajproje test sonuç merkezi
After=network-online.target
Wants=network-online.target

[Service]
User=stajproje
Group=stajproje
WorkingDirectory=/opt/stajproje
# .env burada okunur (DATA_DIR, CI_API_TOKEN, ADMIN_PASSWORD_HASH, ...)
ExecStart=/opt/stajproje/stajproje
Restart=on-failure
RestartSec=5
# SW-10.6: sert bellek sınırı (hedef < 100 MB, normal kullanım ~30 MB)
MemoryMax=150M
MemoryHigh=110M
# sertleştirme
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/stajproje /opt/stajproje
PrivateTmp=true

[Install]
WantedBy=multi-user.target
