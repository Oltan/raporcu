# /etc/systemd/system/raporcu.service
# Kurulum: docs/GITLAB_CI_KURULUMU.md, "raporcu sunucusu (Ubuntu)"
[Unit]
Description=raporcu test sonuç merkezi
After=network-online.target
Wants=network-online.target

[Service]
User=raporcu
Group=raporcu
WorkingDirectory=/opt/raporcu
# .env burada okunur (DATA_DIR, CI_API_TOKEN, ADMIN_PASSWORD_HASH, ...)
ExecStart=/opt/raporcu/raporcu
Restart=on-failure
RestartSec=5
# SW-10.6: sert bellek sınırı (hedef < 100 MB, normal kullanım ~30 MB)
MemoryMax=150M
MemoryHigh=110M
# sertleştirme
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/raporcu /opt/raporcu
PrivateTmp=true

[Install]
WantedBy=multi-user.target
